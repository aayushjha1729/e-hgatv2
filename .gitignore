# Reference papers / third-party materials
# Figures and the compiled manuscript under paper/ are tracked; see the negations.
*.pdf
!paper/figs/*.pdf
!paper/main.pdf
refs/
typeset_equations/

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.xdv
paper/*.fls
paper/*.fdb_latexmk

# Model checkpoints and raw shard output (heavy / regenerable). Aggregated
# per-experiment JSON summaries backing the reported numbers are tracked.
experiments/**/runs/
experiments/**/*.pt
experiments/**/*.png
experiments/**/shards/
!tests/data/golden/**

# Local vector store
data/chromadb/
